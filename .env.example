# ============ Database (PostgreSQL) ============
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=settlement
POSTGRES_USER=settlement
POSTGRES_PASSWORD=settlement

# ============ Redis (hot state: auth, rate-limit, leaderboard) ============
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# ============ Matching Engine (C++20) ============
MATCHING_ENGINE_HOST=localhost
MATCHING_ENGINE_PORT=9001

# ============ API Gateway (Go) ============
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8080
RISK_ENGINE_ADDR=localhost:9002
MATCHING_ENGINE_ADDR=localhost:9001
SETTLEMENT_ADDR=localhost:8083
PROMOTION_ADDR=localhost:8084
NATS_ADDR=localhost:4222
MARKET_DATA_ADDR=localhost:8085

# ============ NATS (event bus) ============
NATS_HOST=localhost
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# ============ Market Data Service (Go) ============
MARKET_DATA_HOST=0.0.0.0
MARKET_DATA_PORT=8085
TIMESCALE_DSN=postgres://market_data:market_data@localhost:5433/market_data?sslmode=disable

# ============ TimescaleDB ============
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5433

# ============ Risk Engine (Go) ============
RISK_ENGINE_HOST=0.0.0.0
RISK_ENGINE_PORT=9002

# ============ Clearing & Settlement (Java 21) ============
SETTLEMENT_HOST=0.0.0.0
SETTLEMENT_PORT=8083
SERVER_PORT=8083
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/settlement
SPRING_DATASOURCE_USERNAME=settlement
SPRING_DATASOURCE_PASSWORD=settlement

# ============ Kafka event backbone (Redpanda local / Kafka-Strimzi prod) ============
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# ============ Accounting & Tax Service (Java 21) ============
ACCOUNTING_TAX_PORT=8086
TAX_RATE=0.10
# Transactional Outbox (clearing-settlement -> accounting events)
ACCOUNTING_OUTBOX_ENABLED=true

# ============ Promotion Service (Node.js / TS) ============
PROMOTION_HOST=0.0.0.0
PROMOTION_PORT=8084

# ============ Logging & Observability ============
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PORT=9090

# ============ Rate limiting (api-gateway) ============
# Requests/second per client IP. 0 disables rate limiting (for stress tests).
RATE_LIMIT_PER_SEC=10000
