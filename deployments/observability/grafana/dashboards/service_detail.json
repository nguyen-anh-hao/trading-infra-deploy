    {
      "id": 16,
      "type": "timeseries",
      "title": "Settlement / accounting / promotion",
      "description": "Business correctness counters; any failure is an incident.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(trading_settlements_total{service=\"$service\"}[5m]))",
