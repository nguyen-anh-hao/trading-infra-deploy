    {
      "id": 11,
      "type": "timeseries",
      "title": "JVM runtime",
      "description": "Spring services: heap and GC pause p99 (docs/baselines.yaml#jvm_gc_pause_p99).",
      "gridPos": {
        "h": 8,
        "w": 12,
