    {
      "id": 14,
      "type": "timeseries",
      "title": "Orders / trades / WebSocket",
      "description": "Business counters for order-service and market-data-service.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(trading_orders_total{service=\"$service\"}[5m]))",
          "legendFormat": "orders {{status}}"
        },
        {
          "refId": "B",
          "expr": "sum by (symbol) (rate(trades_total{service=\"$service\"}[5m]))",
          "legendFormat": "trades/s {{symbol}}"
        },
        {
          "refId": "C",
          "expr": "trading_ws_connections{service=\"$service\"}",
          "legendFormat": "ws clients"
        },
        {
          "refId": "D",
          "expr": "increase(trading_ws_dropped_total{service=\"$service\"}[5m])",
          "legendFormat": "ws dropped/5m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
