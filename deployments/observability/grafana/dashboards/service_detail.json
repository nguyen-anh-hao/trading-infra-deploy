        {
          "refId": "C",
          "expr": "rate(trading_matching_trades_total{service=\"$service\"}[5m])",
          "legendFormat": "trades/s"
        },
        {
          "refId": "D",
          "expr": "rate(trading_matching_errors_total{service=\"$service\"}[5m])",
