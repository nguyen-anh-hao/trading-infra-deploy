{
  "uid": "trading-service-detail",
  "title": "Trading — Service Detail",
  "description": "Per-service RED, saturation, runtime and business metrics. Pick a service above; baselines are defined in docs/baselines.yaml.",
  "tags": [
    "trading",
    "services",
    "red",
    "baseline"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "links": [
    {
      "title": "Baseline documentation",
      "url": "https://github.com/nguyen-anh-hao/trading-infra-deploy/blob/main/docs/BASELINES.md",
      "targetBlank": true
    },
    {
      "title": "All services",
      "url": "/d/trading-service-overview",
      "targetBlank": false
    },
    {
      "title": "Baseline Scorecard",
      "url": "/d/trading-baseline-scorecard",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=~\"api-gateway|order-service|risk-engine|market-data-service|matching-engine|clearing-settlement|promotion-service|accounting-tax-service\"}, service)",
        "includeAll": false,
        "multi": false,
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "order-service",
          "value": "order-service"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "text",
      "title": "Baseline legend",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "### Baseline legend\n\n| Baseline | Target | Severity |\n|---|---|---|\n| HTTP 5xx ratio | <= 0.005 percentunit | critical |\n| Scrape target up | >= 1 short | critical |\n| Order path p99 | <= 0.5 s | critical |\n| HTTP p99 | <= 1 s | warning |\n| Matching engine p99 | <= 0.005 s | critical |\n| HTTP p99/p50 tail ratio | <= 5 short | warning |\n| ... 13 more | see Baseline Scorecard | |\n\nFull catalog and sources: `docs/BASELINES.md` / `docs/baselines.yaml`."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Up",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{service=\"$service\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Request rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(service:http_requests:rate5m{service=\"$service\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx ratio",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:http_error_ratio5m{service=\"$service\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p99 latency",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:http_request_duration_seconds:p99{service=\"$service\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request rate by route / status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path, status) (rate(http_requests_total{service=\"$service\"}[5m]))",
          "legendFormat": "{{path}} {{status}}"
        },
        {
          "refId": "B",
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{service=\"$service\"}[5m]))",
          "legendFormat": "{{uri}} {{status}}"
        },
        {
          "refId": "C",
          "expr": "sum(http_requests_in_flight{service=\"$service\"})",
          "legendFormat": "in flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency distribution",
      "description": "Baseline: p99 <= 1s generic, order path <= 500ms (docs/baselines.yaml#http_p99).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "service:http_request_duration_seconds:p50{service=\"$service\"}",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "service:http_request_duration_seconds:p95{service=\"$service\"}",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "service:http_request_duration_seconds:p99{service=\"$service\"}",
          "legendFormat": "p99"
        },
        {
          "refId": "D",
          "expr": "service:http_request_duration_seconds:p999{service=\"$service\"}",
          "legendFormat": "p999"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed",
              "lineWidth": 1,
              "colorMode": "custom"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "CPU usage / quota",
      "description": "Baseline: <= 70% (docs/baselines.yaml#cpu_usage_ratio).",
      "gridPos": {
        "h": 8,
        "w": 8,
