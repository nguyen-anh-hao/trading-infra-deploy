{
  "uid": "trading-data-pipeline",
  "title": "Trading — Data Pipeline (Outbox / Journal / Kafka / NATS)",
  "tags": ["trading", "outbox", "kafka", "nats", "redis"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Outbox pending",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (service) (trading_outbox_pending)", "legendFormat": "{{service}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Outbox oldest age",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (service) (trading_outbox_oldest_age_seconds)", "legendFormat": "{{service}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 30 }, { "color": "red", "value": 60 }] } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Risk journal length",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "trading_risk_journal_length", "legendFormat": "length" },
        { "refId": "B", "expr": "trading_risk_journal_pending", "legendFormat": "pending" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Risk journal lag",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "trading_risk_journal_lag_seconds", "legendFormat": "seconds" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 10 }, { "color": "red", "value": 30 }] } }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (consumergroup, topic) (kafka_consumergroup_lag)", "legendFormat": "{{consumergroup}}/{{topic}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1000 }, { "color": "red", "value": 10000 }] }, "custom": { "thresholdsStyle": { "mode": "dashed", "lineWidth": 1, "colorMode": "custom" } } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "NATS pending",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(nats_varz_pending_bytes)", "legendFormat": "pending bytes" },
        { "refId": "B", "expr": "max(nats_varz_slow_consumers)", "legendFormat": "slow consumers" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "WebSocket backpressure",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "trading_ws_connections", "legendFormat": "clients" },
        { "refId": "B", "expr": "increase(trading_ws_dropped_total[5m])", "legendFormat": "dropped/5m" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(trading_market_ws_send_duration_seconds_bucket[5m])))", "legendFormat": "send p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Market ticks ingested",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (symbol) (rate(trading_market_ticks_ingested_total[5m]))", "legendFormat": "{{symbol}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Dedupe / redelivery",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(trading_market_dedupe_total[5m])", "legendFormat": "deduped/s" },
        { "refId": "B", "expr": "rate(trading_risk_journal_apply_errors_total[5m])", "legendFormat": "journal errors/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Kafka lag drain time",
      "description": "Hardware-independent view: lag divided by the consumer's current offset rate. Baseline < 30s (docs/baselines.yaml#kafka_consumer_lag).",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (consumergroup, topic) (kafka_consumergroup_lag) / clamp_min(sum by (consumergroup, topic) (rate(kafka_consumergroup_current_offset[5m])), 1e-9)",
          "legendFormat": "{{consumergroup}}/{{topic}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 120 }
            ]
          },
          "custom": { "thresholdsStyle": { "mode": "dashed", "lineWidth": 1, "colorMode": "custom" } }
        },
        "overrides": []
      }
    }
  ]
}
