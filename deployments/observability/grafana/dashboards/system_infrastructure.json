{
  "uid": "system-infrastructure",
  "title": "System Infrastructure",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "CPU Usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(container_cpu_usage_seconds_total[5m])", "legendFormat": "{{name}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory Usage",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "container_memory_usage_bytes", "legendFormat": "{{name}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Network Socket I/O",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(container_network_receive_bytes_total[5m])", "legendFormat": "rx {{name}}" },
        { "expr": "rate(container_network_transmit_bytes_total[5m])", "legendFormat": "tx {{name}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "CFS Throttling",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "rate(container_cpu_cfs_throttled_seconds_total[5m])", "legendFormat": "{{name}}" }
      ]
    }
  ]
}
