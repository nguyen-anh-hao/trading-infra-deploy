// Alloy configuration - Docker logs to Loki

loki.write "loki" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

discovery.docker "docker_logs" {
  host = "unix:///var/run/docker.sock"
}

// Relabel Docker meta labels into useful log labels. The Docker Compose
// service label (com.docker.compose.service) gives clean names like
// "api-gateway" / "risk-engine", so use it for `service_name`.
discovery.relabel "docker_labels" {
  targets = discovery.docker.docker_logs.targets

//  rule {
//    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
//    target_label  = "service_name"
//  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container_name"
  }
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.docker_labels.output
  forward_to = [loki.write.loki.receiver]
}

